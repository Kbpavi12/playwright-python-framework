osition: right bottom;*/\n}\n#spacemyfooter {\n  padding:40px 80px 20px 80px;\n  max-width:1500px;\n  margin:auto;\n}\n.footerlinks_1 {\n  width:auto;\n  float:left;\n  padding:40px 60px;\n  color:#FFF4A3;\n  font-family: Source Sans Pro, sans-serif;\n  font-size:15px;\n}\n.footerlinks_1 .fa-logo {\n  font-size:46px!important;\n  color:#ddd;\n}\n.footerlinks_1:nth-child(1) {\n  padding:30px 10px 30px 40px;\n}\n.footerlinks_1 a{\n  text-decoration:none;\n}\n.footerlinks_1 a:hover,.footerlinks_1 a:active{\n  text-decoration:underline;\n  color:#FFF4A3;\n}\n.footerlinks_1 a:hover,.footerlinks_1 a:active{\n  text-decoration:underline;\n  color:#FFF4A3!;\n}\n.footerlinks_1 a:hover i{\n  color:#FFF4A3!important;\n}\n.footerlinks_2 {\n  width:auto;\n  float:left;\n  padding-left:90px;\n  padding-right:135px;\n  color:#ddd;\n  font-family: Source Sans Pro, sans-serif;\n  font-size:12px;\n  line-height:15px;\n  text-align:center;\n}\n.footerlinks_2:nth-child(4) {\n  padding-right:0;\n}\n.footerlinks_2 h5 {\n  margin-bottom:20px;\n}\n.footerlinks_2 a:visited,.footerlinks_2 a:link{\n  text-decoration:none;\n}\n.footerlinks_2 a:hover,.footerlinks_2 a:active{\n  color:#FFF4A3;\n}\n.footersome {\n  padding:60px 40px 10px 40px;\n  color:#ddd;\n  font-size:20px;\n  text-align:center;\n}\n.footersome a {\n  margin-right:10px;\n}\n.footersome a:hover,.footersome a:active{\n  color:#FFF4A3;\n}\n.footersome .textlink {\n  font-size:15px;\n  text-decoration:none;\n}\n.footersome .textlink:active,.footersome .textlink:hover {\n  text-decoration:underline;\n}\n.footertext {\n  color:#ddd;\n  font-size:12px;\n  line-height:15px;\n  text-align:center;\n}\n.footertext a:hover,.footertext a:active{\n  color:#FFF4A3;\n}\n@media screen and (max-width: 992px) {\n  #wrappercontainer {\n    z-index:0;\n  }\n  .footerlinks_1 {\n    width:100%;\n    margin:auto;\n    float:none;\n    text-align:center;\n    padding:10px 20px!important;\n    font-size:20px;\n  }\n  .footerlinks_1:nth-child(1) {\n    padding:40px 20px;\n  }\n  .footerlinks_2 {\n    width:100%;\n    float:none;\n    margin:auto;\n    font-size:16px;\n    line-height:20px;\n    padding:0;\n  }\n  .footerlinks_2 h5 {\n    font-size:26px;\n    margin-top:40px;\n  }\n  .footertext {\n    padding:0;\n  }\n  .footer-hide-special {\n    display:none;\n  }\n}\n/*\n@media screen and (max-width: 992px) {\n  #footerwrapper {\n    background-image:url('/images/background_in_space.webp');\n    background-color: #282A35;\n    background-repeat: repeat;\n    background-position: left top;\n  }\n}*/\n"],"\n",["DIV",{"id":"footerwrapper"},"\n\n",["STYLE",{},"\n@media screen and (max-width: 1450px) {\n  #spacemyfooter {\n    max-width:1100px;\n  }\n  .footerlinks_1 {\n    padding-left:30px;\n    padding-right:30px;\n  }\n  .footerlinks_2 {\n    padding-right:30px;\n  }\n  .footerlinks_2:nth-child(1) {\n    padding-left:50px;\n  }\n  .footer-hide-special {\n    display:none;\n  }\n}\n@media screen and (max-width: 1100px) {\n  #spacemyfooter {\n    max-width:1000px;\n  }\n  .footerlinks_1 {\n    padding-left:20px;\n    padding-right:20px;\n  }\n  .footerlinks_2 {\n    padding-right:20px;\n  }\n  .footerlinks_2:nth-child(1) {\n    padding-left:20px;\n  }\n}\n"],"\n\n",["STYLE",{},"\n.signup-journey {\n  background:\n    radial-gradient(\n      circle at 95px 70px,\n      rgba(255, 255, 255, 0.65) 0 20px,\n      transparent 21px\n    ),\n    radial-gradient(\n      circle at 120px 55px,\n      rgba(255, 255, 255, 0.65) 0 26px,\n      transparent 27px\n    ),\n    radial-gradient(\n      circle at 150px 72px,\n      rgba(255, 255, 255, 0.65) 0 18px,\n      transparent 19px\n    ),\n    radial-gradient(\n      circle at 300px 170px,\n      rgba(255, 255, 255, 0.35) 0 14px,\n      transparent 15px\n    ),\n    radial-gradient(\n      circle at 320px 160px,\n      rgba(255, 255, 255, 0.35) 0 18px,\n      transparent 19px\n    ),\n    radial-gradient(\n      circle at 342px 170px,\n      rgba(255, 255, 255, 0.35) 0 13px,\n      transparent 14px\n    ),\n    radial-gradient(\n      circle at 82% 65px,\n      rgba(255, 255, 255, 0.55) 0 22px,\n      transparent 23px\n    ),\n    radial-gradient(\n      circle at calc(82% + 26px) 50px,\n      rgba(255, 255, 255, 0.55) 0 28px,\n      transparent 29px\n    ),\n    radial-gradient(\n      circle at calc(82% + 58px) 67px,\n      rgba(255, 255, 255, 0.55) 0 20px,\n      transparent 21px\n    ),\n    linear-gradient(\n      135deg,\n      #f7f4ff 0%,\n      #ebe4ff 55%,\n      #e2d8ff 100%\n    );\n\n  font-family: 'Source Sans Pro', sans-serif;\n}\n\n.signup-journey-inner {\n  position: relative;\n  min-height: 350px;\n  max-width: 1270px;\n  margin: auto;\n  padding: 50px 20px;\n  overflow: hidden;\n  border-radius: 14px;\n  box-sizing: border-box;\n  text-align:left;\n}\n\n.signup-journey-content {\n  position: relative;\n  z-index: 20;\n  width: 54%;\n  max-width: 590px;\n}\n\n.signup-journey h2 {\n  max-width: 570px;\n  margin: 0 0 14px;\n  color: #17141d;\n  font-family: 'Source Sans Pro', sans-serif;\n  font-size: 33px;\n  line-height: 1.15;\n}\n\n.signup-journey-description {\n  max-width: 550px;\n  margin: 0;\n  color: #4d4859;\n  font-size: 16px;\n  line-height: 1.7;\n}\n\n.signup-journey-badges {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 20px;\n}\n\n.signup-journey-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  min-height: 36px;\n  padding: 6px 11px;\n  color: #383243;\n  background-color: rgba(255, 255, 255, 0.94);\n  border: 1px solid rgba(115, 85, 217, 0.16);\n  border-radius: 6px;\n  box-sizing: border-box;\n  box-shadow: 0 2px 8px rgba(67, 47, 110, 0.05);\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.signup-badge-icon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 18px;\n  height: 20px;\n  flex-shrink: 0;\n}\n\n.signup-badge-icon svg,\n.signup-badge-icon img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n}\n\n.signup-badge-streak {\n  width: 18px;\n  height: 21px;\n}\n\n.signup-badge-league {\n  width: 22px;\n  height: 22px;\n}\n\n.signup-journey-action {\n  margin-top: 25px;\n}\n\n.signup-journey-action .ws-btn {\n  display: inline-block;\n}\n\n/* Scene */\n\n.signup-journey-scene {\n  position: absolute;\n  inset: 0;\n  overflow: hidden;\n  pointer-events: none;\n}\n\n/* Background mountains */\n\n.signup-mountain-back {\n  position: absolute;\n  bottom: 0;\n  z-index: 2;\n  width: 320px;\n  height: 210px;\n  background-color: rgba(130, 104, 215, 0.12);\n  clip-path: polygon(\n    0 100%,\n    18% 72%,\n    31% 82%,\n    52% 28%,\n    66% 62%,\n    78% 48%,\n    100% 100%\n  );\n}\n\n.signup-mountain-back-one {\n  right: 360px;\n}\n\n.signup-mountain-back-two {\n  right: 40px;\n  width: 390px;\n  height: 255px;\n  background-color: rgba(115, 85, 217, 0.16);\n}\n\n.signup-mountain-back-three {\n  right: -140px;\n  width: 350px;\n  height: 185px;\n  background-color: rgba(115, 85, 217, 0.1);\n}\n\n/* Mountain, lynx and flag group */\n\n.signup-summit {\n  position: absolute;\n  right: 135px;\n  bottom: -72px;\n  z-index: 4;\n  width: 390px;\n  height: 430px;\n}\n\n/* Foreground mountain */\n\n.signup-mountain-front {\n  position: absolute;\n  right: 0;\n  bottom: 0;\n  width: 370px;\n  height: 255px;\n  background: linear-gradient(\n    145deg,\n    #695497 0%,\n    #493768 100%\n  );\n  clip-path: polygon(\n    5% 100%,\n    18% 52%,\n    34% 43%,\n    43% 13%,\n    57% 5%,\n    72% 26%,\n    85% 55%,\n    100% 100%\n  );\n}\n\n.signup-mountain-front::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background-color: rgba(255, 255, 255, 0.1);\n  clip-path: polygon(\n    43% 13%,\n    57% 5%,\n    50% 48%,\n    34% 43%\n  );\n}\n\n.signup-mountain-front::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background-color: rgba(32, 22, 55, 0.18);\n  clip-path: polygon(\n    57% 5%,\n    72% 26%,\n    85% 55%,\n    64% 47%\n  );\n}\n\n/* Lynx */\n\n.signup-hero {\n  position: absolute;\n  right: 110px;\n  bottom: 126px;\n  z-index: 9;\n  width: 135px;\n  height: 245px;\n}\n\n.signup-hero-body {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n}\n\n/* Flag */\n\n.signup-flag-pole {\n  position: absolute;\n  right: 235px;\n  bottom: 157px;\n  z-index: 8;\n  width: 5px;\n  height: 224px;\n  background-color: #2e2735;\n  border-radius: 4px;\n  transform: rotate(-2deg);\n  transform-origin: bottom;\n}\n\n.signup-flag-pole::before {\n  content: \"\";\n  position: absolute;\n  top: -8px;\n  left: -4px;\n  width: 13px;\n  height: 13px;\n  background-color: #2e2735;\n  border-radius: 50%;\n}\n\n.signup-flag {\n  position: absolute;\n  top: 4px;\n  left: 4px;\n  width: 105px;\n  height: 65px;\n  overflow: hidden;\n  background-color: #27222e;\n  clip-path: polygon(\n    0 0,\n    88% 8%,\n    100% 3%,\n    91% 50%,\n    100% 94%,\n    84% 88%,\n    0 82%\n  );\n}\n\n.signup-flag .fa-logo {\n  position: absolute;\n  top: 15px;\n  left: 35px;\n  color: #ffffff;\n  font-size: 28px;\n  line-height: 1;\n  transform: rotate(2.5deg);\n}\n\n\n/* Progress card */\n\n.signup-progress {\n  position: absolute;\n  right: 80px;\n  bottom: 25px;\n  z-index: 12;\n  width: 165px;\n  padding: 18px;\n  background-color: rgba(255, 255, 255, 0.96);\n  border: 1px solid #e2dced;\n  border-radius: 9px;\n  box-sizing: border-box;\n  box-shadow: 0 8px 22px rgba(57, 43, 88, 0.1);\n}\n\n.signup-progress-top {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 11px;\n  color: #373142;\n  font-size: 11px;\n  font-weight: 700;\n}\n\n.signup-progress-top strong {\n  color: #6346d8;\n  font-size: 17px;\n}\n\n.signup-progress-bar {\n  height: 8px;\n  overflow: hidden;\n  background-color: #e9e5ef;\n  border-radius: 5px;\n}\n\n.signup-progress-fill {\n  width: 5%;\n  height: 100%;\n  background-color: #04aa6d;\n  border-radius: 5px;\n}\n\n.signup-progress-lessons {\n  