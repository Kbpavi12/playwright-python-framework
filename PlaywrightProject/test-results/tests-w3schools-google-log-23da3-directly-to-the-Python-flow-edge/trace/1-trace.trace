{"type":"frame-snapshot","snapshot":{"callId":"call@12","snapshotName":"after@call@12","pageId":"page@a156394722aea960e3f7eda18de35907","frameId":"frame@29786d910a1138588c30755a156a4d3e","frameUrl":"https://www.w3schools.com/howto/tryhow_js_slideshow_ifr.htm","doctype":"html","html":["HTML",{},["HEAD",{},["BASE",{"href":"https://www.w3schools.com/howto/tryhow_js_slideshow_ifr.htm"}],"\n",["META",{"name":"viewport","content":"width=device-width, initial-scale=1"}],"\n",["STYLE",{},"\n* {box-sizing: border-box}\nbody {font-family: Verdana, sans-serif; margin:0}\n.mySlides {display: none}\nimg {vertical-align: middle;}\n\n/* Slideshow container */\n.slideshow-container {\n  max-width: 1000px;\n  position: relative;\n  margin: auto;\n}\n\n/* Next & previous buttons */\n.prev, .next {\n  cursor: pointer;\n  position: absolute;\n  top: 50%;\n  width: auto;\n  padding: 16px;\n  margin-top: -22px;\n  color: white;\n  font-weight: bold;\n  font-size: 18px;\n  transition: 0.6s ease;\n  border-radius: 0 3px 3px 0;\n  user-select: none;\n}\n\n/* Position the \"next button\" to the right */\n.next {\n  right: 0;\n  border-radius: 3px 0 0 3px;\n}\n\n/* On hover, add a black background color with a little bit see-through */\n.prev:hover, .next:hover {\n  background-color: rgba(0,0,0,0.8);\n}\n\n/* Caption text */\n.text {\n  color: #f2f2f2;\n  font-size: 15px;\n  padding: 8px 12px;\n  position: absolute;\n  bottom: 8px;\n  width: 100%;\n  text-align: center;\n}\n\n/* Number text (1/3 etc) */\n.numbertext {\n  color: #f2f2f2;\n  font-size: 12px;\n  padding: 8px 12px;\n  position: absolute;\n  top: 0;\n}\n\n/* The dots/bullets/indicators */\n.dot {\n  cursor: pointer;\n  height: 15px;\n  width: 15px;\n  margin: 0 2px;\n  background-color: #bbb;\n  border-radius: 50%;\n  display: inline-block;\n  transition: background-color 0.6s ease;\n}\n\n.active, .dot:hover {\n  background-color: #717171;\n}\n\n/* Fading animation */\n.fade {\n  -webkit-animation-name: fade;\n  -webkit-animation-duration: 1.5s;\n  animation-name: fade;\n  animation-duration: 1.5s;\n}\n\n@-webkit-keyframes fade {\n  from {opacity: .4} \n  to {opacity: 1}\n}\n\n@keyframes fade {\n  from {opacity: .4} \n  to {opacity: 1}\n}\n\n/* On smaller screens, decrease text size */\n@media only screen and (max-width: 300px) {\n  .prev, .next,.text {font-size: 11px}\n}\n"],"\n"],"\n",["BODY",{"style":"background-color:#e3e6e8"},"\n\n",["DIV",{"class":"slideshow-container"},"\n\n",["DIV",{"class":"mySlides fade","style":"display: block;"},"\n  ",["DIV",{"class":"numbertext"},"1 / 3"],"\n  ",["IMG",{"__playwright_current_src__":"https://www.w3schools.com/howto/img_nature_wide.jpg","src":"img_nature_wide.jpg","style":"width:100%"}],"\n  ",["DIV",{"class":"text"},"Caption Text"],"\n"],"\n\n",["DIV",{"class":"mySlides fade","style":"display: none;"},"\n  ",["DIV",{"class":"numbertext"},"2 / 3"],"\n  ",["IMG",{"__playwright_current_src__":"https://www.w3schools.com/howto/img_snow_wide.jpg","src":"img_snow_wide.jpg","style":"width:100%"}],"\n  ",["DIV",{"class":"text"},"Caption Two"],"\n"],"\n\n",["DIV",{"class":"mySlides fade","style":"display: none;"},"\n  ",["DIV",{"class":"numbertext"},"3 / 3"],"\n  ",["IMG",{"__playwright_current_src__":"https://www.w3schools.com/howto/img_mountains_wide.jpg","src":"img_mountains_wide.jpg","style":"width:100%"}],"\n  ",["DIV",{"class":"text"},"Caption Three"],"\n"],"\n\n",["A",{"class":"prev","onclick":""},"❮"],"\n",["A",{"class":"next","onclick":""},"❯"],"\n\n"],"\n",["BR"],"\n\n",["DIV",{"style":"text-align:center"},"\n  ",["SPAN",{"class":"dot active","onclick":""}]," \n  ",["SPAN",{"class":"dot","onclick":""}]," \n  ",["SPAN",{"class":"dot","onclick":""}]," \n"],"\n\n","\n\n\n "]],"viewport":{"width":920,"height":388},"timestamp":3695.626,"wallTime":1788160000955,"collectionTime":0.800000011920929,"resourceOverrides":[],"isMainFrame":false}}
