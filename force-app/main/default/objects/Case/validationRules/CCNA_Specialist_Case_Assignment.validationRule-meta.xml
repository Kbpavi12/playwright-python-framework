<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CCNA_Specialist_Case_Assignment</fullName>
    <active>true</active>
    <errorConditionFormula>AND
(
	$UserRole.DeveloperName = &apos;CCNA_Specialist_User&apos;, 
	ISCHANGED(OwnerId),
	Owner:Queue.DeveloperName = &apos;CCNA_Main_Unscanned&apos;,
	ISPICKVAL( Country_Code__c , &apos;US&apos;))</errorConditionFormula>
    <errorMessage>You are only allowed to assign a case to Main Unscanned Queue.</errorMessage>
</ValidationRule>
