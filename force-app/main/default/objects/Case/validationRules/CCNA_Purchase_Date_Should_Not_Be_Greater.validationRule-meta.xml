<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CCNA_Purchase_Date_Should_Not_Be_Greater</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL( Country_Code__c , &quot;US&quot;),
Purchase_Date__c &gt; NOW() )</errorConditionFormula>
    <errorDisplayField>Purchase_Date__c</errorDisplayField>
    <errorMessage>You are not allowed to select Future Date.</errorMessage>
</ValidationRule>
