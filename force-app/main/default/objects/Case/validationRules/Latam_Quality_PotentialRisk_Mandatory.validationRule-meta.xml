<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Latam_Quality_PotentialRisk_Mandatory</fullName>
    <active>true</active>
    <description>High Potential Risk Field is mandatory for Latam Quality Case</description>
    <errorConditionFormula>AND( 
   $Profile.Name &lt;&gt; &quot;System Administrator&quot;,   
   TEXT($User.UserType) &lt;&gt; &quot;AutomatedProcess&quot;,
   RecordType.DeveloperName = &quot;Latam_Quality&quot;,
   ISPICKVAL(High_Potential_Risk__c, &quot;&quot;) 
)</errorConditionFormula>
    <errorDisplayField>High_Potential_Risk__c</errorDisplayField>
    <errorMessage>Potential Risk is mandatory</errorMessage>
</ValidationRule>
