<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CCNA_Status_Cancelled_Without_CaseReason</fullName>
    <active>true</active>
    <description>Case Status cannot be Cancelled without Cancel Reason.</description>
    <errorConditionFormula>AND(ISPICKVAL(Country_Code__c,&apos;US&apos;),
				OR(ISPICKVAL(Status,&apos;Cancelled&apos;),
							ISPICKVAL(Status,&apos;Case Cancelled&apos;)
						),
				ISPICKVAL(Cancel_Reason__c,&apos;&apos;)
			)</errorConditionFormula>
    <errorDisplayField>Cancel_Reason__c</errorDisplayField>
    <errorMessage>Please enter cancellation reason.</errorMessage>
</ValidationRule>
