<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CCNA_DateTime_View_Should_Not_Be_Greater</fullName>
    <active>true</active>
    <description>Date/Time Viewed should not be future date.</description>
    <errorConditionFormula>AND(ISPICKVAL( Country_Code__c , &quot;US&quot;),
Date_Time_Viewed__c &gt; NOW() )</errorConditionFormula>
    <errorDisplayField>Date_Time_Viewed__c</errorDisplayField>
    <errorMessage>You are not allowed to select Future Date.</errorMessage>
</ValidationRule>
