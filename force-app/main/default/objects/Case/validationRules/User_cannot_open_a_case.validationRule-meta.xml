<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>User_cannot_open_a_case</fullName>
    <active>true</active>
    <description>Bottler Salesforce CSC User cannot open a case.</description>
    <errorConditionFormula>ISPICKVAL(Country_Code__c,&apos;JP&apos;) &amp;&amp; CONTAINS($UserRole.Name, &apos;Salesforce&apos;) &amp;&amp; IsPickVal( Status ,&apos;Open&apos;) &amp;&amp; (ISCHANGED(Status) || ISNEW())</errorConditionFormula>
    <errorDisplayField>X1st_task__c</errorDisplayField>
    <errorMessage>Cases can only be kept in status new, not opened. Bottler HQ will be responsible for changing it to open.</errorMessage>
</ValidationRule>
