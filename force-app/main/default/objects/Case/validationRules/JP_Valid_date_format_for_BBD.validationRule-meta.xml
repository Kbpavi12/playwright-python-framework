<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>JP_Valid_date_format_for_BBD</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL(Country_Code__c,&apos;JP&apos;),
NOT(OR(REGEX(BBD__c ,&quot;([0-9]{4}/(0[13578]|1[02])/(0[1-9]|[1-2][0-9]|3[0-1]))&quot;), REGEX(BBD__c ,&quot;([0-9]{4}/(0[469]|11)/(0[1-9]|[1-2][0-9]|30))&quot;), REGEX(BBD__c ,&quot;([0-9]{4}/(02)/(0[1-9]|[1-2][0-9]))&quot;), REGEX(BBD__c , &quot;([0-9]{4}/(0[13578]|1[02])/(0[1-9]|[1-2][0-9]|3[0-1]))&quot;), REGEX(BBD__c , &quot;([0-9]{4}/(0[469]|11)/(0[1-9]|[1-2][0-9]|30))&quot;), REGEX(BBD__c , &quot;([0-9]{4}/(02)/(0[1-9]|[1-2][0-9]))&quot;), ISBLANK(BBD__c )))
)</errorConditionFormula>
    <errorDisplayField>BBD__c</errorDisplayField>
    <errorMessage>Please enter valid format - YYYY/MM/DD</errorMessage>
</ValidationRule>
