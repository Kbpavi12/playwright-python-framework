<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Current_Fiscal_Week__c</fullName>
    <description>This formula calculates the current fiscal week for the year 2021 based on the current date.</description>
    <externalId>false</externalId>
    <formula>MOD(FLOOR( (TODAY() - DATEVALUE(&quot;2021-01-02&quot;)) /7),52)+1</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Current Fiscal Week</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
